<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping auto-import="false" default-lazy="false">
	<import class="com.hrms.employee.model.Employee" />
	<class name="com.hrms.employee.model.impl.EmployeeImpl" table="HRMS_Employee">
		<id name="employeeId" type="long">
			<generator class="assigned" />
		</id>
		<property name="employeeCode" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="firstName" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="lastName" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="email" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="phoneNumber" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="department" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="designation" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="joiningDate" type="org.hibernate.type.TimestampType" />
		<property name="status" type="com.liferay.portal.dao.orm.hibernate.StringType" />
	</class>
</hibernate-mapping>