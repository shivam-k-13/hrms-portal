<?xml version="1.0"?>

<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.0.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_0_0.dtd">

<service-builder package-path="com.hrms.employee">

    <namespace>HRMS</namespace>

    <entity
        local-service="true"
        name="Employee"
        remote-service="false">

        <column name="employeeId" primary="true" type="long" />

        <column name="employeeCode" type="String" />
        <column name="firstName" type="String" />
        <column name="lastName" type="String" />
        <column name="email" type="String" />
        <column name="phoneNumber" type="String" />
        <column name="department" type="String" />
        <column name="designation" type="String" />
        <column name="joiningDate" type="Date" />
        <column name="status" type="String" />

    </entity>

</service-builder>